{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shamddd/ear_grpo_reasoning/results/schema.json",
  "title": "EAR-GRPO evaluation summary",
  "type": "object",
  "required": [
    "schema_version",
    "verification_scope",
    "metric",
    "mean",
    "standard_deviation",
    "sample_count",
    "seed",
    "model",
    "dataset",
    "split",
    "config_sha256"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "verification_scope": { "type": "string" },
    "metric": { "type": "string" },
    "mean": { "type": "number" },
    "standard_deviation": { "type": "number", "minimum": 0 },
    "sample_count": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "model": { "type": "string" },
    "dataset": { "type": "string" },
    "split": { "type": "string" },
    "config_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": true
}
